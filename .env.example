# =========================================================
# CONFIGURACIÓN DE ENTORNO (.env.example)
# ---------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores a tu entorno:
#     cp .env.example .env   (Linux/Mac)
#     copy .env.example .env (Windows)
# La aplicación también puede recibir estas variables desde el
# entorno real (docker-compose, hosting). El archivo .env solo
# se usa cuando la variable NO está definida previamente.
# =========================================================

# Servidor y base de datos MySQL
DB_HOST=localhost
DB_NAME=tutorias_db
DB_USER=tutorias_user
DB_PASS=cambia_esta_contrasena

# Persistencia y verificación de la conexión PDO
DB_PERSISTENT=1
DB_PING=1

# ------------------------------------------------------------------
# docker-compose (desarrollo local). Los valores por defecto
# coinciden con la BD inicial del contenedor; sobreescribe aquí
# cuando uses credenciales propias (NO uses estas en producción):
# ------------------------------------------------------------------
# DB_PASS=12345
# DB_ROOT_PASSWORD=root_password